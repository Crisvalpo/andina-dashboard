# ================================================================
# Dashboard Andina — Variables de entorno
# Copiar a .env y completar. El archivo .env NUNCA se commitea.
# ================================================================

# Servidor
PORT=3005
ZONA_HORARIA=America/Santiago

# AppSheet (datos del proyecto piping)
APPSHEET_APP_ID=
APPSHEET_ACCESS_KEY=

# Supabase local (self-hosted, esquema del bot)
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=andina

# Gemini (IA del bot conversacional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOZ=Charon

# WA Bridge (microservicio Baileys, instancia exclusiva del dashboard)
WA_BRIDGE_URL=http://localhost:3035
WA_BRIDGE_PORT=3035
WA_BRIDGE_SECRET=
WA_WEBHOOK_URL=http://localhost:3005/api/whatsapp-incoming

# Autodesk Platform Services (visor BIM)
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_MODEL_URN=

# Control de acceso (escritura). La lectura del dashboard es siempre abierta.
# Claves compartidas por área — cámbialas y reinicia el proceso para rotarlas.
CLAVE_BIM=          # desbloquea "vincular elementos 3D a spool"
CLAVE_BOT=          # desbloquea administración del bot (config, usuarios, QR)
SESSION_SECRET=     # cadena aleatoria larga que firma los tokens de sesión
